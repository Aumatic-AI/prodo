# Prodo environment variables. Same names for every client deployment,
# different values per deployment. Copy to .env.local for local development.
# Never commit real values.

# --- Supabase (this client's own project) ---
# Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Settings -> API Keys -> publishable key (the old "anon" key). Browser and logged-in API calls
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settings -> API. Background jobs and agents (bypasses RLS). Server only
SUPABASE_SERVICE_ROLE_KEY=
# The id in the dashboard URL. CLI: migrations and types
SUPABASE_PROJECT_REF=
# Account -> Access Tokens. CLI: migrations and types
SUPABASE_ACCESS_TOKEN=
# Saved when the project was created. CLI: migrations
SUPABASE_DB_PASSWORD=

# --- Test login (development only; Claude uses it to test screens and API) ---
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# --- AI ---
# Text, vision, embeddings
OPENAI_API_KEY=
# Must match the vector size in the migrations (brand_chunks, hook_library)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Images (nano-banana) and video clips (Seedance)
KIE_API_KEY=
# Voice-over with timestamps, music
ELEVENLABS_API_KEY=

# --- Research ---
# Website crawl, page map, screenshots
FIRECRAWL_API_KEY=
# Video understanding (hook, structure, pacing)
TWELVELABS_API_KEY=
# Public social profiles and posts, Meta and Google ad libraries, Google search (replaces SerpAPI)
SCRAPECREATORS_API_KEY=

# --- Publishing ---
# Zernio: publishing, scheduling, connected accounts, per-post analytics (default from Phase 1.5)
ZERNIO_API_KEY=
# Upload-Post: legacy, kept so posts made before Zernio still show their status
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# --- FFmpeg worker (self-hosted on Hostinger, see worker/README.md) ---
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=

# --- Inngest (this client's own environment; never share between clients) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 for the local Inngest dev server. Never set in production
INNGEST_DEV=

# --- Development ---
# Record every outside call and database change of a research run in .logs/research (npm run trace). Never in production.
TRACE_LOG=
