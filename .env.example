# Prodo environment variables. One deploy serves every business (one login each), so these
# are set once per deploy, not per business. Copy to .env.local for local development.
# Never commit real values.

# --- Supabase (one project for all businesses; rows are kept apart by business_id) ---
# Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Settings -> API Keys -> publishable key (the old "anon" key). Browser and logged-in API calls
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settings -> API. Background jobs and agents (bypasses RLS). Server only
SUPABASE_SERVICE_ROLE_KEY=
# The id in the dashboard URL. CLI: migrations and types
SUPABASE_PROJECT_REF=
# Account -> Access Tokens. CLI: migrations and types
SUPABASE_ACCESS_TOKEN=
# Saved when the project was created. CLI: migrations
SUPABASE_DB_PASSWORD=

# --- Cloudflare R2 (file storage: photos, logos, ads, videos) ---
# R2 -> Account Details -> Account ID
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Object Read & Write on the bucket. Server only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prodo-media
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# The bucket's public address (r2.dev for development, a custom domain in production)
NEXT_PUBLIC_MEDIA_URL=

# --- Test login (development only; Claude uses it to test screens and API) ---
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Optional: the business smoke tests run as (default: the first one that finished onboarding)
SMOKE_BUSINESS_ID=

# --- AI ---
# Text, vision, embeddings
OPENAI_API_KEY=
# Must match the vector size in the migrations (brand_chunks, hook_library)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Images (nano-banana) and video clips (Seedance)
KIE_API_KEY=
# Voice-over with timestamps, music
ELEVENLABS_API_KEY=

# --- Research ---
# Website crawl, page map, screenshots
FIRECRAWL_API_KEY=
# Video understanding (hook, structure, pacing)
TWELVELABS_API_KEY=
# Public social profiles and posts, Meta and Google ad libraries, Google search (replaces SerpAPI)
SCRAPECREATORS_API_KEY=

# --- Publishing ---
# Zernio: publishing, scheduling, connected accounts, per-post analytics (default from Phase 1.5).
# One key for all businesses; each business gets its own Zernio profile automatically
ZERNIO_API_KEY=
# Upload-Post: old posts made before Zernio, and video rendering until our worker is set up.
# UPLOAD_POST_PROFILE is one profile for the whole deploy, used only by those old posts
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# --- Video rendering ---
# Our FFmpeg worker (self-hosted on Hostinger, see worker/README.md). When both are set, videos render there.
# Until then videos render on Upload-Post's FFmpeg API with UPLOAD_POST_API_KEY (uses its monthly processing minutes).
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
# Optional: force one renderer (worker | upload-post)
RENDERER=

# --- Email (Resend): plan-ready, approval and failure emails ---
# Emails are only logged until EMAIL_ENABLED=1. The recipient is Settings → Automation → notification email.
RESEND_API_KEY=
EMAIL_FROM=Prodo <hello@yourdomain.com>
EMAIL_ENABLED=
# Public address of this deploy, for links in emails (e.g. https://app.prodo.app)
APP_URL=

# --- Inngest (this deploy's own environment; never share it with another deploy) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 for the local Inngest dev server. Never set in production
INNGEST_DEV=

# --- Development ---
# Record every outside call and database change of a research run in .logs/research (npm run trace). Never in production.
TRACE_LOG=
