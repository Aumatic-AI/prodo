# Domain pointing at this VPS, e.g. render.yourdomain.com (Caddy gets the HTTPS cert)
WORKER_DOMAIN=

# Same value as FFMPEG_WORKER_SECRET in the app. Make one with: openssl rand -hex 32
WORKER_SECRET=

# Prodo's Supabase project (service role / secret key, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hosts allowed as inputs besides Supabase, comma separated (Kie result file hosts)
ALLOWED_INPUT_HOSTS=aiquickdraw.com,redpandaai.co,kie.ai

# Optional
# ffmpeg jobs at a time, Remotion renders at a time (raise MAX_RENDERS on a bigger VPS), time limit per job
MAX_CONCURRENT=2
MAX_RENDERS=1
JOB_TIMEOUT_MS=600000
