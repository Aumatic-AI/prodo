# Domain pointing at this VPS, e.g. render.yourdomain.com (Caddy gets the HTTPS cert)
WORKER_DOMAIN=

# Same value as FFMPEG_WORKER_SECRET in the app. Make one with: openssl rand -hex 32
WORKER_SECRET=

# Cloudflare R2, Prodo's file storage (same values as the app; the API token needs read and write)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public address (NEXT_PUBLIC_MEDIA_URL in the app)
R2_PUBLIC_URL=

# Hosts allowed as inputs besides our storage, comma separated (Kie result file hosts)
ALLOWED_INPUT_HOSTS=aiquickdraw.com,redpandaai.co,kie.ai

# Optional
# ffmpeg jobs at a time, Remotion renders at a time (raise MAX_RENDERS on a bigger VPS), time limit per job
MAX_CONCURRENT=2
MAX_RENDERS=1
JOB_TIMEOUT_MS=600000
# Browser tabs per render (empty = half the CPU threads; lower it if renders get killed for memory)
RENDER_CONCURRENCY=
# Memory for decoded video frames per render, in MB
VIDEO_CACHE_MB=512
